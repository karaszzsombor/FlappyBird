<Window x:Class="FlappyBird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlappyBird"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="MyCanvas">
            <Image x:Name="bird"  Height="50" Width="50" Canvas.Left="153" Canvas.Top="42" Source="https://toppng.com/public/uploads/preview/flappy-bird-sprite-11549936843rfq2kg39db.png">
                <Image.RenderTransform>
                    <RotateTransform x:Name="birdRotate" Angle="0" CenterX="25" CenterY="25"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>

    </Grid>
</Window>
